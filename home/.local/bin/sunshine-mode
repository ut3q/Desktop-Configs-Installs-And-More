#!/usr/bin/env bash
# sunshine-mode — switch how Sunshine captures the desktop.
#
#   mirror   (default, safe) capture the physical monitor directly. The screen
#            at your desk keeps working. The stream is whatever the panel is:
#            1920x1080 16:9, letterboxed on a 19.5:9 phone.
#
#   virtual  capture a headless output sized to the client. On connect the
#            physical monitor is DISABLED, so Hyprland migrates every workspace
#            onto the virtual screen and the client gets its native resolution
#            and aspect. Your desk screen is blank for the duration.
#
# Sunshine resolves output_name once at startup, so switching restarts it.
#
# hyprctl keyword/dispatch are no-ops under this machine's Lua config parser.
# Everything here goes through `hyprctl eval` and is verified by read-back.

set -uo pipefail

CONF="${HOME}/.config/sunshine/sunshine.conf"
MODE_FILE="${HOME}/.config/sunshine/mode"
UNIT="app-dev.lizardbyte.app.Sunshine.service"
WATCH_UNIT="sunshine-scale-watch.service"
VD_WORKSPACE="remote"
VD_POS="9999x0"
VD_DEFAULT_MODE="1920x1080@60"

log() { printf '[mode] %s\n' "$*" >&2; }

notify() {  # $1=title $2=body $3=icon
  command -v notify-send >/dev/null 2>&1 || return 0
  notify-send -a "Sunshine" -i "${3:-video-display}" "$1" "$2" >/dev/null 2>&1
}

current_mode() { cat "$MODE_FILE" 2>/dev/null || echo mirror; }

if [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
  d="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hypr"
  [ -d "$d" ] && export HYPRLAND_INSTANCE_SIGNATURE="$(find "$d" -maxdepth 1 -mindepth 1 -type d -printf '%T@ %f\n' 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2)"
fi
hyprctl version >/dev/null 2>&1 || { log "cannot reach Hyprland"; exit 1; }

headless_name() {
  hyprctl monitors all -j | python3 -c 'import sys,json;print(next((m["name"] for m in json.load(sys.stdin) if m["name"].startswith("HEADLESS-")),""))'
}
physical_name() {
  hyprctl monitors all -j | python3 -c 'import sys,json;print(next((m["name"] for m in json.load(sys.stdin) if not m["name"].startswith("HEADLESS-")),""))'
}
active_ws_of() {
  hyprctl monitors all -j | python3 -c "
import sys, json
m = next((m for m in json.load(sys.stdin) if m['name'] == '$1'), None)
print(m['activeWorkspace']['name'] if m else '')"
}
set_output_name() {
  if grep -qE '^output_name' "$CONF"; then
    sed -i "s|^output_name[[:space:]]*=.*|output_name = $1|" "$CONF"
  else
    printf 'output_name = %s\n' "$1" >> "$CONF"
  fi
  log "output_name = $1"
}
restart_sunshine() {
  # Each mode switch is a restart, and systemd rate-limits starts. Clearing any
  # failed state first means a tripped limiter cannot leave Sunshine dead.
  systemctl --user reset-failed "$UNIT" "$WATCH_UNIT" >/dev/null 2>&1
  systemctl --user restart "$UNIT" >/dev/null 2>&1
  systemctl --user restart "$WATCH_UNIT" >/dev/null 2>&1

  local i
  for i in $(seq 20); do
    sleep 1
    systemctl --user is-active "$UNIT" >/dev/null 2>&1 && { log "restarted Sunshine and the watcher"; return 0; }
  done
  log "WARNING: Sunshine did not come back up"
  notify "Sunshine did not restart" "Run: systemctl --user reset-failed sunshine && systemctl --user start sunshine" "dialog-error"
  return 1
}

# The rule MUST exist before the output is created, or Hyprland parks a numeric
# workspace on it -- which is then reachable by SUPER+scroll and strands the
# cursor on a screen at 9999x0 that you cannot see.
declare_ws_rule() {
  hyprctl eval "hl.workspace_rule({workspace=\"name:$VD_WORKSPACE\", monitor=\"$1\", default=true, persistent=true})" >/dev/null
}
create_headless() {
  local n i
  hyprctl output create headless >/dev/null
  for i in $(seq 20); do n=$(headless_name); [ -n "$n" ] && break; sleep 0.1; done
  printf '%s\n' "$n"
}

cmd_virtual() {
  local name next
  name=$(headless_name)
  if [ -z "$name" ]; then
    name=$(create_headless)
    [ -z "$name" ] && { log "failed to create headless output"; exit 1; }
    if [ "$(active_ws_of "$name")" != "$VD_WORKSPACE" ]; then
      next="HEADLESS-$(( ${name##*-} + 1 ))"
      hyprctl output remove "$name" >/dev/null; sleep 0.5
      declare_ws_rule "$next"
      name=$(create_headless)
      [ -z "$name" ] && { log "failed to recreate headless output"; exit 1; }
    fi
  else
    declare_ws_rule "$name"
    if [ "$(active_ws_of "$name")" != "$VD_WORKSPACE" ]; then
      # Stale output holding a numeric workspace. Recreate it with the rule
      # already declared rather than leaving it to strand the cursor.
      log "$name holds workspace '$(active_ws_of "$name")'; recreating it"
      next="HEADLESS-$(( ${name##*-} + 1 ))"
      hyprctl output remove "$name" >/dev/null; sleep 0.6
      declare_ws_rule "$next"
      name=$(create_headless)
      [ -z "$name" ] && { log "failed to recreate headless output"; exit 1; }
    fi
  fi
  hyprctl eval "hl.monitor({output=\"$name\", mode=\"$VD_DEFAULT_MODE\", position=\"$VD_POS\", scale=1})" >/dev/null

  local ws; ws=$(active_ws_of "$name")
  if [ "$ws" != "$VD_WORKSPACE" ]; then
    log "WARNING: $name shows workspace '$ws', not '$VD_WORKSPACE' -- aborting to avoid stranding the cursor"
    hyprctl output remove "$name" >/dev/null
    notify "Mode switch failed" "Could not create a clean virtual display. Still in mirror mode." "dialog-error"
    exit 1
  fi

  echo virtual > "$MODE_FILE"
  set_output_name "$name"
  restart_sunshine
  log "virtual mode. Your monitor blanks while a client is connected."
  notify "Virtual display mode" "Clients get their native resolution. This screen blanks while streaming." "video-display"
}

cmd_mirror() {
  local name phys
  phys=$(physical_name)
  # Never leave the physical monitor disabled.
  [ -n "$phys" ] && hyprctl eval "hl.monitor({output=\"$phys\", disabled=false})" >/dev/null
  name=$(headless_name)
  [ -n "$name" ] && { hyprctl output remove "$name" >/dev/null; log "removed $name"; }
  echo mirror > "$MODE_FILE"
  set_output_name "${phys:-DP-3}"
  restart_sunshine
  log "mirror mode. Your monitor stays on; stream is $( [ -n "$phys" ] && echo "$phys" || echo DP-3 )."
  notify "Mirror mode" "Streaming this screen at 1920x1080. Your monitor stays on." "video-display"
}

cmd_status() {
  echo "mode        : $(cat "$MODE_FILE" 2>/dev/null || echo mirror)"
  echo "output_name : $(sed -n 's/^output_name[[:space:]]*=[[:space:]]*//p' "$CONF" | head -1)"
  echo "physical    : $(physical_name)"
  echo "headless    : $(headless_name || echo none)"
  hyprctl monitors all -j | python3 -c '
import sys, json
for m in json.load(sys.stdin):
    print(f"  {m[\"name\"]:<12} {m[\"width\"]}x{m[\"height\"]} at {m[\"x\"]},{m[\"y\"]} ws={m[\"activeWorkspace\"][\"name\"]}")' 2>/dev/null || true
  echo "sunshine    : $(systemctl --user is-active "$UNIT")"
}

client_connected() {
  journalctl --user -u "$UNIT" -n 200 --no-pager -o cat 2>/dev/null \
    | grep -E 'CLIENT (CONNECTED|DISCONNECTED)' | tail -1 | grep -q 'CLIENT CONNECTED'
}

warn_if_streaming() {
  if client_connected; then
    log "a client is connected; switching now restarts Sunshine and drops the stream"
    notify "Switching while streaming" "Sunshine will restart and your stream will drop. Reconnect after." "dialog-warning"
  fi
}

cmd_toggle() {
  warn_if_streaming
  if [ "$(current_mode)" = "virtual" ]; then cmd_mirror; else cmd_virtual; fi
}

case "${1:-status}" in
  virtual) cmd_virtual ;;
  mirror)  cmd_mirror ;;
  toggle)  cmd_toggle ;;
  status)  cmd_status ;;
  *) echo "usage: $(basename "$0") {mirror|virtual|toggle|status}" >&2; exit 2 ;;
esac
