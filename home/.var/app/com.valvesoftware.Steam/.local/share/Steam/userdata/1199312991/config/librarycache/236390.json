rentProgress":0,"flMaxProgress":30},{"strID":"steam_trophy_played_mission_on_1_place","strName":"First-class","strDescription":"Play 3 battles, taking first place in any team","strImage":"https://shared.steamstatic.com/community_assets/images/apps/236390/3e3217963b15f0397d5f08209cfa1930032254d5.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":23,"flMinProgress":0,"flCurrentProgress":1,"flMaxProgress":3},{"strID":"steam_trophy_kill_2_players_while_burning","strName":"Cold-Blooded","strDescription":"Destroy 2 players' vehicles while your vehicle's on fire","strImage":"https://shared.steamstatic.com/community_assets/images/apps/236390/383d3f71431de1d9724089cb276da10bf9c21de2.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":21.100000381469727,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":2},{"strID":"steam_trophy_activate_10_boosters","strName":"Speed up!","strDescription":"Activate 10 boosters","strImage":"https://shared.steamstatic.com/community_assets/images/apps/236390/5a195afae7578350965edbe58320262b389fc658.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":18.200000762939453,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":10},{"strID":"steam_trophy_kill_5_players_while_on_zone","strName":"King of the Hill","strDescription":"Destroy in one battle 5 players' vehicles while standing on the strategic point captured by your team","strImage":"https://shared.steamstatic.com/community_assets/images/apps/236390/1e587d0b2d3991bcd5557b939e7e04d8501b1e63.jpg","bAchieved":false,"rtUnlocked":0,"flAchieved":15.899999618530273,"flMinProgress":0,"flCurrentProgress":0,"flMaxProgress":5}],"vecAchievedHidden":[],"nTotal":91,"nAchieved":2}}],["associations",{"version":2,"data":{"rgDevelopers":[{"strName":"Gaijin Entertainment","strURL":null}],"rgPublishers":[{"strName":"Gaijin Network Ltd","strURL":"https://store.steampowered.com/publisher/gjn_ntw_ltd"}],"rgFranchises":[]}}],["descriptions",{"version":1,"data":{"strFullDescription":"[p][imgvid poster.avif=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/236390/extras/4dd974ef2221302188173d11f26f3b2a.poster.avif?t=1780485515\" webm=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/236390/extras/4dd974ef2221302188173d11f26f3b2a.webm?t=1780485515\" webp=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/236390/extras/4dd974ef2221302188173d11f26f3b2a.webp?t=1780485515\" width=\"780\" height=\"400\"][/imgvid][/p][p]\r\n[/p][p][b]War Thunder[/b] is the most comprehensive free-to-play, cross-platform, MMO military game dedicated to aviation, armoured vehicles, from the early 20th century to the most advanced modern combat units. Join now and take part in major battles on land, in the air, and at sea, fighting with millions of players from all over the world in an ever-evolving environment.\r\n[/p][p][imgvid poster.avif=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/236390/extras/b4b9bbc29596dece5f7885b1308b639b.poster.avif?t=1780485515\" webm=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/236390/extras/b4b9bbc29596dece5f7885b1308b639b.webm?t=1780485515\" webp=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/236390/extras/b4b9bbc29596dece5f7885b1308b639b.webp?t=1780485515\" width=\"780\" height=\"350\"][/imgvid][/p][p]\r\n[/p][p]\r\n[/p][p]In War Thunder, aircraft, attack helicopters, ground forces and naval ships collaborate in realistic competitive battles. You can choose from over 3,000 vehicles and an extensive variety of combat situations many of which are exclusive. You can find yourself blasting your pursuers from a bomber turret, defending your teammates on the ground from an air raid with anti-aircraft guns, shooting down enemy planes with a firestorm from multiple rocket launchers, or trying to sink an enemy warship with a torpedo from a fast attack boat. \r\n[/p][p]\r\n[/p][p]\r\n[/p][p][imgvid poster.avif=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/236390/extras/1c6134e20b3a9cf8c71db6adcc81de4f.poster.avif?t=1780485515\" webm=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/236390/extras/1c6134e20b3a9cf8c71db6adcc81de4f.webm?t=1780485515\" webp=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/236390/extras/1c6134e20b3a9cf8c71db6adcc81de4f.webp?t=1780485515\" width=\"780\" height=\"350\"][/imgvid][/p][h2]Features include:[/h2][p]\r\n[/p][list][*][p]Seamless cross-platform gameplay between Windows PC, Linux, Mac, PlayStation®4, PlayStation®5, Xbox One with Xbox Series X|S – everyone on the same server.\r\n[/p][/*][*][p]Over 3,000 highly detailed aircraft, helicopters, tanks, warships and other combat vehicles crafted carefully from historical documents and surviving sources. \r\n[/p][/*][*][p]100 maps representing the main historical battle theaters.\r\n[/p][/*][*][p]Intense PvP experiences in full-scale combat missions at various difficulty settings for all play styles and degrees of experience.\r\n[/p][/*][*][p]Rich PvE content including dynamic historical campaigns and solo missions.\r\n[/p][/*][*][p]Regular content updates including new vehicles, maps, missions and nations.\r\n[/p][/*][*][p]Astonishing graphics, authentic sound effects and beautiful music creating an atmosphere to fully immerse yourself in.\r\n[/p][/*][*][p]Create custom content for War Thunder and share it on War Thunder Live, with the prospect of earning real money through the Revenue Share Partner System!\r\n[/p][/*][/list][p]\r\n[/p][p][imgvid poster.avif=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/236390/extras/411eb8940b5b505105f54734b5324d6e.poster.avif?t=1780485515\" webm=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/236390/extras/411eb8940b5b505105f54734b5324d6e.webm?t=1780485515\" webp=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/236390/extras/411eb8940b5b505105f54734b5324d6e.webp?t=1780485515\" width=\"780\" height=\"350\"][/imgvid][/p]","strSnippet":"War Thunder is the most comprehensive free-to-play, cross-platform, MMO military game dedicated to aviation, armoured vehicles, and naval craft, from the early 20th century to the most advanced modern combat units. Join now and take part in major battles on land, in the air, and at sea."}}]]